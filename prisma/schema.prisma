// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  invoiceEmail  String?   @unique
  taxId         String?   @unique
  password      String
  name          String?
  saldoAFavor   Float     @default(0)  // Saldo a favor acumulado de períodos anteriores
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  passwordResetCodes PasswordResetCode[]
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Invoice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Invoice metadata
  fileName          String
  tipo              String   // 'GASTO' o 'EMITIDA'
  
  // Invoice details
  numeroConsecutivoEncrypted Json?
  clave             String?
  fechaEmision      DateTime?
  emisorNombreEncrypted Json?
  emisorIdentificacionEncrypted Json?
  receptorNombreEncrypted Json?
  receptorIdentificacionEncrypted Json?
  
  // Amounts - Base amounts (subtotals) for Hacienda declaration
  subtotalGravadoEncrypted Json?
  subtotalExentoEncrypted Json?
  tarifaIVA         Float?   @default(13) // Tarifa de IVA predominante de la factura
  
  // Totals used by reports
  totalImpuestoEncrypted Json?
  totalComprobanteEncrypted Json?
  
  // Exchange rate (for foreign currency)
  tipoMoneda        String?
  tipoCambio        Float?   @default(1)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([tipo])
  @@index([fechaEmision])
  @@unique([userId, clave])
}

model EmailLog {
  id                String   @id @default(cuid())
  messageId         String   @unique  // Email Message-Id from Mailgun
  sender            String              // Email sender
  recipient         String              // Email recipient (mapped to user)
  subject           String              // Email subject
  attachmentCount   Int      @default(0) // Total attachments received
  processedCount    Int      @default(0) // Successfully processed attachments
  skippedCount      Int      @default(0) // Skipped attachments (PDFs, duplicates, etc)
  failedCount       Int      @default(0) // Failed attachments
  success           Boolean  @default(false) // Overall success status
  errorMessage      String?             // Error message if failed
  processingTimeMs  Int?                // Processing time in milliseconds
  userId            String?             // Associated user (if found)
  createdAt         DateTime @default(now())
  
  @@index([recipient])
  @@index([userId])
  @@index([createdAt])
}
