generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  invoiceEmail  String?   @unique
  taxId         String?   @unique
  password      String
  name          String?
  saldoAFavor   Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  passwordResetCodes PasswordResetCode[]
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Invoice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName          String
  tipo              String

  numeroConsecutivoEncrypted Json?
  clave             String?
  fechaEmision      DateTime?
  emisorNombreEncrypted Json?
  emisorIdentificacionEncrypted Json?
  receptorNombreEncrypted Json?
  receptorIdentificacionEncrypted Json?

  documentType      String   @default("FacturaElectronica")
  signo             Int      @default(1)

  subtotalGravadoEncrypted Json?
  subtotalExentoEncrypted Json?
  subtotalExoneradoEncrypted Json?
  subtotalNoSujetoEncrypted Json?
  tarifaIVA         Float?   @default(13)

  totalImpuestoEncrypted Json?
  totalComprobanteEncrypted Json?

  tipoMoneda        String?
  tipoCambio        Float?   @default(1)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([tipo])
  @@index([fechaEmision])
  @@unique([userId, clave])
}

model EmailLog {
  id                String   @id @default(cuid())
  messageId         String   @unique
  sender            String
  recipient         String
  subject           String
  attachmentCount   Int      @default(0)
  processedCount    Int      @default(0)
  skippedCount      Int      @default(0)
  failedCount       Int      @default(0)
  success           Boolean  @default(false)
  errorMessage      String?
  skippedDetails    String?
  processingTimeMs  Int?
  userId            String?
  createdAt         DateTime @default(now())

  @@index([recipient])
  @@index([userId])
  @@index([createdAt])
}
